DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_GOVERNANCE_MODEL=deepseek-v4-flash
DEEPSEEK_BUSINESS_MODEL=deepseek-v4-flash
DEEPSEEK_ATTRIBUTION_MODEL=deepseek-v4-flash
DEEPSEEK_METRIC_AUTHORING_MODEL=deepseek-v4-flash
DEEPSEEK_METRIC_AUTHORING_TIMEOUT_MS=60000
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=20000

# Data source: json | mysql | sqlserver
LUMINAX_DATA_SOURCE=json
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=luminax
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_SSL=false
MYSQL_SSL_CA=
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_CONNECTION_LIMIT=2
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=10000
MYSQL_CACHE_TTL_MS=30000

# Optional. When empty, the POC admin API only accepts localhost requests.
LUMINAX_ADMIN_TOKEN=
LUMINAX_METRIC_REGISTRY_PATH=
